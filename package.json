{
	"name": "@blakron/ui",
	"version": "1.0.6",
	"description": "EUI-compatible UI component framework for the Blakron game engine — skin-based components, layouts, data binding, view states",
	"author": "Kelvin <kyia.x52@gmail.com>",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist/**/*"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc --build",
		"dev": "tsc --watch",
		"clean": "rm -rf dist",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@blakron/core": "^1.0.3"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"happy-dom": "^20.8.9",
		"typescript": "^5.6.0",
		"vitest": "^4.1.4"
	},
	"keywords": [
		"blakron",
		"ui",
		"eui",
		"skin",
		"h5-game",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/irwinmc/blakron-ui.git"
	},
	"packageManager": "pnpm@10.33.0"
}
